#
# Android fstab file.
#
# <src>                           <mnt_point>            <type> <mnt_flags and options>                                                                                      <fs_mgr_flags>

# System / Vendor / Product
system                            /system                ext4   ro                                                                                                           wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey,slotselect
system_ext                        /system_ext            ext4   ro                                                                                                           wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
product                           /product               ext4   ro                                                                                                           wait,avb,logical,first_stage_mount,slotselect
vendor                            /vendor                erofs  ro                                                                                                           wait,avb,logical,first_stage_mount,slotselect

# Boot / DTBO
/dev/block/by-name/boot           /boot                  emmc   defaults                                                                                                     first_stage_mount,nofail,slotselect
/dev/block/by-name/dtbo           /dtbo                  emmc   defaults                                                                                                     defaults,slotselect

# Vbmeta
/dev/block/by-name/vbmeta_system  /vbmeta_system         emmc   defaults                                                                                                     first_stage_mount,nofail,slotselect,avb=vbmeta
/dev/block/by-name/vbmeta         /vbmeta                emmc   defaults                                                                                                     defaults,slotselect

# Userdata
/dev/block/by-name/md_udc         /metadata              ext4   noatime,nosuid,nodev,discard                                                                                 wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata       /data                  f2fs   noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt  latemount,wait,check,quota,reservedsize=128M,formattable,resize,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/userdata       /data                  ext4   noatime,nosuid,nodev,noauto_da_alloc,errors=panic,inlinecrypt                                                latemount,wait,check,quota,reservedsize=128M,formattable,resize,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized,keydirectory=/metadata/vold/metadata_encryption

# Persistent
/dev/block/by-name/nvcfg          /mnt/vendor/nvcfg      ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                     wait,check,formattable
/dev/block/by-name/nvdata         /mnt/vendor/nvdata     ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                     wait,check,formattable
/dev/block/by-name/persist        /mnt/vendor/persist    ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                     wait,check,formattable
/dev/block/by-name/protect1       /mnt/vendor/protect_f  ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                     wait,check,formattable
/dev/block/by-name/protect2       /mnt/vendor/protect_s  ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                     wait,check,formattable

/dev/block/by-name/boot_para      /boot_para             emmc   defaults                                                                                                     defaults
/dev/block/by-name/cid            /cid                   emmc   defaults                                                                                                     defaults
/dev/block/by-name/efuse          /efuse                 emmc   defaults                                                                                                     defaults
/dev/block/by-name/expdb          /expdb                 emmc   defaults                                                                                                     defaults
/dev/block/by-name/flashinfo      /flashinfo             emmc   defaults                                                                                                     defaults
/dev/block/by-name/frp            /persistent            emmc   defaults                                                                                                     defaults
/dev/block/by-name/hw             /hw                    emmc   defaults                                                                                                     defaults
/dev/block/by-name/kpan           /kpan                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/logs           /logs                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/misc           /misc                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/nvram          /nvram                 emmc   defaults                                                                                                     defaults
/dev/block/by-name/otp            /otp                   emmc   defaults                                                                                                     defaults
/dev/block/by-name/pad1           /pad1                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/para           /para                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/proinfo        /proinfo               emmc   defaults                                                                                                     defaults
/dev/block/by-name/sec1           /sec1                  emmc   defaults                                                                                                     defaults
/dev/block/by-name/seccfg         /seccfg                emmc   defaults                                                                                                     defaults
/dev/block/by-name/sp             /sp                    emmc   defaults                                                                                                     defaults
/dev/block/by-name/utags          /utags                 emmc   defaults                                                                                                     defaults
/dev/block/by-name/utagsBackup    /utagsBackup           emmc   defaults                                                                                                     defaults

# Firmware
/dev/block/by-name/gz             /gz                    emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/lk             /lk                    emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/logo           /logo                  emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/md1img         /md1img                emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/scp            /scp                   emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/spmfw          /spmfw                 emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/sspm           /sspm                  emmc   defaults                                                                                                     defaults,slotselect
/dev/block/by-name/tee            /tee                   emmc   defaults                                                                                                     defaults,slotselect

# External Storage
/devices/platform/externdevice*   auto                   auto   defaults                                                                                                     voldmanaged=sdcard1:auto
/devices/platform/mt_usb*         auto                   vfat   defaults                                                                                                     voldmanaged=usbotg:auto
