import /vendor/etc/init/hw/init.mt6765.charger.rc
import /vendor/etc/init/hw/init.mt6765.connectivity.rc
import /vendor/etc/init/hw/init.mt6765.power.rc
import /vendor/etc/init/hw/init.mt6765.usb.rc
import /vendor/etc/init/hw/init.moto.fingerprint.rc
import /vendor/etc/init/hw/init.moto.sensors.rc

on early-init
    write /sys/class/net/ccmni0/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni1/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni2/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni0/queues/rx-0/rps_flow_cnt "1000"
    write /sys/class/net/ccmni1/queues/rx-0/rps_flow_cnt "1000"
    write /sys/class/net/ccmni2/queues/rx-0/rps_flow_cnt "1000"

# We need vold early for metadata encryption
on early-fs
    start vold

on fs
    # Early mount required partitions.
    mount_all /vendor/etc/fstab.mt6765 --early

on late-fs
    # Mount remaining partitions under latemount.
    mount_all /vendor/etc/fstab.mt6765 --late

on post-fs-data
    # Set permissions for nvcfg
    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg
    chown system system /mnt/vendor/nvcfg/fg
    chown system system /mnt/vendor/nvcfg/fg/old_fg_data
    chown system system /mnt/vendor/nvcfg/fg/car_tune_value

    # We chown/chmod /mnt/vendor/nvdata again because mount is run as root + defaults
    chown root system /mnt/vendor/nvdata
    chmod 0771 /mnt/vendor/nvdata
    mkdir /mnt/vendor/nvdata/media 0771 media audio

    # Set SELinux security contexts on upgrade or policy update.
    restorecon_recursive /mnt/vendor/nvdata

    # Audio
    mkdir /data/vendor/audiohal 0771 system audio
    mkdir /data/vendor/audiohal/audio_param 0771 system audio

    # Display
    chmod 0664 /dev/graphics/fb0
    chown system graphics /dev/graphics/fb0

    chmod 0664 /dev/mtk_disp_mgr
    chown system graphics /dev/mtk_disp_mgr

    chmod 0444 /dev/mtk_disp

    chmod 0660 /dev/mtkfb_vsync
    chown system graphics /dev/mtkfb_vsync

    chmod 0640 /dev/mdp_sync
    chown system system /dev/mdp_sync

    chmod 0660 /dev/sw_sync
    chown system graphics /dev/sw_sync

    chmod 0640 /dev/mtk_cmdq
    chown system system /dev/mtk_cmdq

    chmod 0640 /proc/m4u
    chown system media /proc/m4u

    chown system graphics /proc/mtk_jpeg
    chmod 0660 /proc/mtk_jpeg

    # Media
    chmod 0660 /dev/Vcodec
    chown media system /dev/Vcodec
    chmod 0660 /dev/Vcodec2
    chown media system /dev/Vcodec2
    mkdir /data/vendor/vcodec 0777 media system

    chmod 0664 /sys/bus/platform/drivers/emi_ctrl/concurrency_scenario
    chown media media /sys/bus/platform/drivers/emi_ctrl/concurrency_scenario

    chmod 0660 /dev/MTK_SMI
    chown media media /dev/MTK_SMI

    # RIL
    chmod 660 /dev/ttyGS0
    chown system radio /dev/ttyGS0
    chmod 660 /dev/ttyGS1
    chown system radio /dev/ttyGS1
    chown system radio /dev/ttyGS3
    chmod 0660 /dev/ttyGS3

    chown root radio /dev/ptmx

    mkdir /dev/radio 0770 radio radio

    mkdir /data/vendor_de/meta 0770 system system
    mkdir /data/vendor_de/meta/mddb 0770 system system

    # Finish the post-fs-data phase.
    setprop vold.post_fs_data_done 1

on boot
    insmod /vendor/lib/modules/mt6357-accdet.ko
